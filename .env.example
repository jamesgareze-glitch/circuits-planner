# Postgres connection string (Sevalla gives you this when you add a Postgres database)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# The single shared passcode used to log into the app
APP_PASSCODE="changeme"

# Random secret used to sign the login cookie — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
