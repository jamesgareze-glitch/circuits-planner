// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id            String         @id @default(cuid())
  name          String         @unique
  sortOrder     Int            @default(0)
  exercises     Exercise[]
  sessionBlocks SessionBlock[]
}

model Exercise {
  id                String            @id @default(cuid())
  name              String
  description       String?
  categoryId        String
  category          Category          @relation(fields: [categoryId], references: [id])
  estimatedMinutes  Int
  minTempC          Int?
  maxTempC          Int?
  avoidRain         Boolean           @default(false)
  avoidHighWind     Boolean           @default(false)
  seasons           String[]
  upvotes           Int               @default(0)
  downvotes         Int               @default(0)
  createdAt         DateTime          @default(now())
  comments          ExerciseComment[]
  sessionExercises  SessionExercise[]
}

model ExerciseComment {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  text       String
  createdAt  DateTime @default(now())
}

model Session {
  id               String            @id @default(cuid())
  date             DateTime
  dateIsGuess      Boolean           @default(false)
  title            String?
  rawContent       String?
  targetMinutes    Int?
  notes            String?
  attendanceCount  Int?
  shareSlug        String            @unique
  sourceFilename   String?           @unique
  createdAt        DateTime          @default(now())
  exercises        SessionExercise[]
  blocks           SessionBlock[]
  feedback         Feedback[]
}

model SessionBlock {
  id          String            @id @default(cuid())
  sessionId   String
  session     Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  orderIndex  Int
  type        String // "category" | "text"
  categoryId  String?
  category    Category?         @relation(fields: [categoryId], references: [id])
  textContent String?
  exercises   SessionExercise[]

  // Routine structure (category blocks only)
  format         String   @default("straight_sets") // "straight_sets" | "circuit" | "amrap" | "emom" | "wod" | "tabata" | "superset" | "ladder"
  rounds         Int?
  workSeconds    Int?
  restSeconds    Int?
  timeCapMinutes Int?
  isPartner      Boolean  @default(false)
  partnerNote    String?

  // Ladder-specific (format = "ladder"): reps or seconds climb from ladderStart to
  // ladderEnd in steps of ladderStep; if ladderPyramid, it climbs back down again.
  ladderStart   Int?
  ladderEnd     Int?
  ladderStep    Int?
  ladderPyramid Boolean @default(false)
  ladderUnit    String? // "reps" | "seconds"

  @@index([sessionId])
}

model SessionExercise {
  id               String        @id @default(cuid())
  sessionId        String
  session          Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  blockId          String?
  block            SessionBlock? @relation(fields: [blockId], references: [id], onDelete: Cascade)
  exerciseId       String
  exercise         Exercise      @relation(fields: [exerciseId], references: [id])
  orderIndex       Int
  allocatedMinutes Int?
  weight           Float?
  reps             Int?

  @@index([exerciseId])
  @@index([blockId])
}

model Feedback {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model Settings {
  id                          Int     @id @default(1)
  weatherFilter               Boolean @default(true)
  seasonFilter                Boolean @default(true)
  recencyFilter               Boolean @default(true)
  recencyWeeks                Int     @default(2)
  exercisesPerCategoryDefault Int     @default(1)
}
